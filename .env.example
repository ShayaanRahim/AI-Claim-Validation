# Environment
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/claim_validation

# OpenAI (required for AI validation endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI thresholds
AI_CONFIDENCE_THRESHOLD=0.75
AI_AUTO_APPROVE_THRESHOLD=0.95

# Authentication (set AUTH_DISABLED=true only for local test runs)
AUTH_DISABLED=false
SYSTEM_API_KEY=change-me-system-key
REVIEWER_API_KEY=change-me-reviewer-key
